[Unit]
Description=OpenRGB SDK Server
ConditionPathExistsGlob=!/sys/class/power_supply/BAT*
ConditionPathExists=/usr/bin/openrgb

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do [ -r /dev/i2c-6 ] && [ -w /dev/i2c-6 ] && break; sleep 1; done'
ExecStart=/usr/bin/openrgb --server --server-port 6742
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
