[Unit]
Description=llama-server running Qwen3.5-0.8B BF16 (256K Context)
After=network.target
Conflicts=llama-qwen35.service llama-qwen36.service strata-qwen36.service

[Service]
Type=simple
ExecStart=/usr/bin/llama-server \
  -m %h/.local/share/models/qwen3.5-0.8b/Qwen3.5-0.8B-BF16.gguf \
  --alias qwen3.5-0.8b \
  --host 127.0.0.1 \
  --port 8080 \
  -ngl 99 \
  -fa on \
  -c 262144 \
  -np 1 \
  -ub 512 \
  --jinja \
  --temp 0.6 \
  --top-p 0.95 \
  --top-k 20 \
  --presence-penalty 1.0
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
