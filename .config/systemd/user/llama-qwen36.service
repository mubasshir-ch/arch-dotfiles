[Unit]
Description=llama-server running Qwen3.6-35B-A3B UD-IQ3_S (32K Context)
After=network.target
Conflicts=llama-qwen35.service llama-qwen35-0.8b.service strata-qwen36.service

[Service]
Type=simple
ExecStart=/usr/bin/llama-server \
  -m %h/.local/share/models/qwen3.6-35b-a3b/Qwen3.6-35B-A3B-UD-IQ3_S.gguf \
  --alias qwen3.6-35b-a3b \
  --host 127.0.0.1 \
  --port 8080 \
  --fit on \
  -fa on \
  -c 32768 \
  -np 1 \
  -ub 512 \
  --jinja \
  --temp 0.6 \
  --top-p 0.95 \
  --top-k 20 \
  --presence-penalty 1.0
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
