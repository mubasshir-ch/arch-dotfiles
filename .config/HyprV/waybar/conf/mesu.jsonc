{
    "custom/clock": {
        "format": "{}",
        "interval": 1,
        "exec": "~/.config/HyprV/waybar/scripts/waybar-clock",
        "return-type": "json",
        "on-click": "~/.config/HyprV/waybar/scripts/waybar-clock toggle",
        "signal": 8
    },
    "custom/weather": {
        //shows the current weather and forecast
        "tooltip": true,
        "format": "{}",
        "interval": 30,
        "exec": "~/.config/HyprV/waybar/scripts/waybar-wttr-c.py",
        "return-type": "json"
    },
    "custom/sysmon": {
        "format": "{}",
        "format-alt": "{alt}",
        "format-alt-click": "click-right",
        "interval": 3,
        "exec": "~/.config/HyprV/waybar/scripts/sysmon.py",
        "return-type": "json",
        "on-click": "kitty --start-as=fullscreen --title btop sh -c 'btop'"
    },
    "temperature": {
        "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
        "input-filename": "temp1_input",
        "format": "󰔏",
        "format-alt-click": "click-right",
        "format-alt": "󰔏 {temperatureC}°C",
        "critical-threshold": 70,
        "format-critical": "󱃂 {temperatureC}°C",
        "on-click": "kitty --start-as=fullscreen --title btop sh -c 'btop'"
    }
}
