{
    "custom/clock": {
        "format": "{}",
        "interval": 1,
        "exec": "~/.config/HyprV/waybar/scripts/waybar-clock",
        "return-type": "json",
        "on-click": "~/.config/HyprV/waybar/scripts/waybar-clock toggle",
        "signal": 8
    },
    "custom/window": {
        "format": "{}",
        "interval": 1,
        "exec": "~/.config/HyprV/waybar/scripts/waybar-window",
        "return-type": "json",
        "on-click": "~/.config/HyprV/waybar/scripts/waybar-window toggle",
        "signal": 7,
        "tooltip": true
    },
    "custom/weather": {
        //shows the current weather and forecast
        "tooltip": true,
        "format": "{}",
        "interval": 30,
        "exec": "~/.config/HyprV/waybar/scripts/waybar-wttr-c.py",
        "return-type": "json"
    },
    "custom/keybinds": {
        "format": "{}",
        "tooltip": true,
        "exec": "~/.config/HyprV/waybar/scripts/hypr-keybinds.py",
        "return-type": "json",
        "interval": 10,
        "on-click": "kitty -e nvim ~/.config/hypr/hyprland.conf"
    },
    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂚",
            "dnd-notification": "󰂛<sup></sup>",
            "dnd-none": "󰂛",
            "inhibited-notification": "󱅫",
            "inhibited-none": "󰂚",
            "dnd-inhibited-notification": "󰂛<sup></sup>",
            "dnd-inhibited-none": "󰂛"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "custom/sysmon": {
        "format": "{}",
        "format-alt": "{alt}",
        "format-alt-click": "click-right",
        "interval": 3,
        "exec": "~/.config/HyprV/waybar/scripts/sysmon.py",
        "return-type": "json",
        "on-click": "kitty --start-as=fullscreen --title btop sh -c 'btop'"
    },
    "custom/hypridle": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/hypr/hypridle/hypridle-ctl status",
        "on-click": "~/.config/hypr/hypridle/hypridle-ctl next",
        "on-click-right": "~/.config/hypr/hypridle/hypridle-ctl prev",
        "interval": 30,
        "signal": 10,
        "tooltip": true
    },
    "temperature": {
        "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
        "input-filename": "temp1_input",
        "format": "󰔏",
        "format-alt-click": "click-right",
        "format-alt": "󰔏 {temperatureC}°C",
        "critical-threshold": 70,
        "format-critical": "󱃂 {temperatureC}°C",
        "on-click": "kitty --start-as=fullscreen --title btop sh -c 'btop'"
    }
}
