#!/usr/bin/env python3
import datetime
import calendar
import json
import os
import sys
import subprocess

STATE_FILE = "/tmp/waybar_clock_mode"

def toggle():
    mode = "compact"
    if os.path.exists(STATE_FILE):
        try:
            with open(STATE_FILE, "r") as f:
                mode = f.read().strip()
        except Exception:
            mode = "compact"
    new_mode = "full" if mode == "compact" else "compact"
    try:
        with open(STATE_FILE, "w") as f:
            f.write(new_mode)
    except Exception:
        pass
    # Signal waybar to refresh custom/clock immediately
    subprocess.run(["pkill", "-SIGRTMIN+8", "waybar"], stderr=subprocess.DEVNULL)

if len(sys.argv) > 1 and sys.argv[1] == "toggle":
    toggle()
    sys.exit(0)

# Generate current status
now = datetime.datetime.now()
utc_now = datetime.datetime.now(datetime.timezone.utc)
tz_name = now.astimezone().tzname() or "Local"

mode = "compact"
if os.path.exists(STATE_FILE):
    try:
        with open(STATE_FILE, "r") as f:
            mode = f.read().strip()
    except Exception:
        mode = "compact"

if mode == "full":
    text = now.strftime("%A, %d %B %Y · %I:%M:%S%p")
else:
    text = now.strftime("%a %d · %I:%M%p")

# Modern, well-spaced calendar grid matching the tabular design of the weather tooltip
WIDTH = 37
divider = "<span color='#313244'>" + "─" * WIDTH + "</span>"

weekdays = ["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"]
wd_str = "   ".join(f"<span color='#f9e2af'><b>{wd}</b></span>" for wd in weekdays)

cal = calendar.Calendar(firstweekday=6) # Sunday first
weeks = cal.monthdatescalendar(now.year, now.month)

cal_rows = []
cal_rows.append(f"<span color='#6c7086'><i>   </i></span>  {wd_str}")

for w in weeks:
    # ISO week number based on Thursday of the row
    iso_week = w[4].isocalendar()[1]
    w_str = f"<span color='#6c7086'><i>W{iso_week:02d}</i></span>"
    
    day_strs = []
    for d in w:
        if d.month != now.month:
            day_strs.append("  ")
        elif d.day == now.day:
            day_strs.append(f"<span background='#fab387' color='#11111b'><b>{d.day:2d}</b></span>")
        else:
            day_strs.append(f"<span color='#cdd6f4'>{d.day:2d}</span>")
    cal_rows.append(f"{w_str}  " + "   ".join(day_strs))

lines = []

# 1. Header with calendar icon & centered Month Year
header_scale = 14 / 12
header_w = round(WIDTH / header_scale)
month_title = f"󰃭  {now.strftime('%B %Y')}".center(header_w)
lines.append(f"<span size='14pt' color='#cba6f7'><b>{month_title}</b></span>")
lines.append(divider)

# 2. Calendar Grid
lines.extend(cal_rows)
lines.append(divider)

# 3. Modern Time Cards with Nerd Icons
loc_12 = now.strftime('%I:%M:%S%p')
loc_24 = now.strftime('%H:%M:%S')
utc_12 = utc_now.strftime('%I:%M:%S%p')
utc_24 = utc_now.strftime('%H:%M:%S')

lines.append(f"<span color='#fab387'></span>  <b>Local</b> <span color='#6c7086'>({tz_name})</span>    {loc_12}   <span color='#a6adc8'>{loc_24}</span>")
lines.append(f"<span color='#89b4fa'>󰥔</span>  <b>UTC</b>            {utc_12}   <span color='#a6adc8'>{utc_24}</span>")

tooltip = f"<span font_family='JetBrainsMono Nerd Font'>\n" + "\n".join(lines) + "\n</span>"

data = {
    "text": text,
    "tooltip": tooltip,
    "class": "clock"
}
print(json.dumps(data), flush=True)
